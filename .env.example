# 监听地址，格式为 ip:port，例如 :8080
LISTEN=127.0.0.1:8080

# 日志文件保存路径
LOG=/var/log/bepusdt/

# SQLite 数据库文件路径（如果使用 MySQL，此项可忽略）
SQLITE=/var/lib/bepusdt/sqlite.db

# PostgreSQL 数据库
# POSTGRESQL_DSN=postgres://user:password@localhost:5432/bepusdt?sslmode=disable&connect_timeout=3&timezone=Asia/Shanghai

# Signed merchant API used by Sub2API. Use the same key ID and secret in
# Sub2API's USDT_PAYMENT_KEY_ID / USDT_PAYMENT_API_SECRET settings.
BEPUSDT_HMAC_KEY_ID=sub2api
BEPUSDT_HMAC_SECRET=
# Browser title shown by the native checkout page.
BEPUSDT_CHECKOUT_TITLE=加密货币收款网关
# Comma-separated public callback and redirect host allowlists.
BEPUSDT_NOTIFY_HOSTS=
BEPUSDT_REDIRECT_HOSTS=
BEPUSDT_HMAC_CLOCK_SKEW_SECONDS=300
BEPUSDT_SCANNER_MAX_AGE_SECONDS=120
BEPUSDT_SCANNER_MIN_SUCCESS_RATE=99
BEPUSDT_SCANNER_MAX_LAG_BLOCKS=30
BEPUSDT_SCANNER_QUEUE_MAX=80
BEPUSDT_CALLBACK_BACKLOG_MAX=50
# EVM endpoints may be comma-separated; the scanner fails over on RPC errors.
BEPUSDT_RPC_ENDPOINT_BSC=
BEPUSDT_RPC_ENDPOINT_TRON=
